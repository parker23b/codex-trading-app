APP_NAME=Algo Trading Platform API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Local-only SQLite database. Keep SQLite files out of git.
DATABASE_URL=sqlite:///./trading_platform.db
BROKER_PROVIDER=IG
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STARTING_ACCOUNT_VALUE=100000
DASHBOARD_RECENT_TRADE_WINDOW=30
MARKET_DATA_POLL_INTERVAL_SECONDS=2
BROKER_RECONCILIATION_INTERVAL_SECONDS=60
OPERATOR_API_TOKEN=
# Leave IG credentials blank until you intentionally need broker-read checks.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_API_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_REQUEST_TIMEOUT_SECONDS=10
IG_TRADING_ENABLED=false
IG_LIVE_TRADING_ACKNOWLEDGED=false
IG_STREAMING_ENABLED=true
IG_STREAMING_WATCH_INTERVAL_SECONDS=1
IG_MARKET_CACHE_TTL_SECONDS=30
IG_MARKET_CACHE_STALE_TTL_SECONDS=300
IG_NON_TRADING_ACCOUNT_ALLOWANCE_PER_MINUTE=24
IG_ALLOWANCE_CIRCUIT_BREAKER_SECONDS=60
IG_VERIFY_SSL=true
IG_CA_BUNDLE_PATH=
TESTING_ROUTES_ENABLED=false

AI_REVIEWER_LLM_ENABLED=false
AI_REVIEWER_LLM_PROVIDER=disabled
AI_REVIEWER_LLM_MODEL=unconfigured
# AI_REVIEWER_LLM_ENABLED=true
# AI_REVIEWER_LLM_PROVIDER=openai
# AI_REVIEWER_LLM_MODEL=gpt-5
# OPENAI_API_KEY=...
