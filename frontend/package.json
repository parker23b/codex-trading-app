{
  "name": "trading-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:lockfile": "npm ci --ignore-scripts --dry-run",
    "audit:unused": "knip",
    "audit:arch": "depcruise app components lib --config .dependency-cruiser.cjs",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx",
    "audit": "npm run audit:lockfile && npm run lint && npm run typecheck && npm run audit:unused && npm run audit:arch && npm run audit:deps"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "knip": "^6.9.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
